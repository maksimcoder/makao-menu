# Contentful — Content Delivery API (публичный read-only токен, только для фронта)
# Скопируйте в .env.local и подставьте значения из админки Contentful.

# Space ID: Settings → General settings → Space ID
VITE_CONTENTFUL_SPACE_ID=

# Content Delivery API access token: Settings → Content delivery / preview tokens
VITE_CONTENTFUL_DELIVERY_TOKEN=

# Environment ID (обычно master): Settings → Environments
VITE_CONTENTFUL_ENVIRONMENT=master

# EU data residency: раскомментируйте, если space в EU
# VITE_CONTENTFUL_HOST=cdn.eu.contentful.com

# Server-side (Vercel Edge Function) — тот же Space ID, что и VITE_CONTENTFUL_SPACE_ID
CONTENTFUL_SPACE_ID=

# Проксировать Contentful Images через Vercel Edge (/cdn/...)
# VITE_USE_IMAGE_PROXY=false  — отключить (например, локально без proxy)
